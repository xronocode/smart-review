{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "smart-audit run metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolVersion", "scoringVersion", "repo", "profile", "audits", "rubrics", "startedAt", "previous", "accepted", "guidanceFile"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "toolVersion": { "type": "string" },
    "scoringVersion": { "type": "string" },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "branch", "dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "profile": { "type": "string" },
    "lang": { "type": "string", "enum": ["en", "ru"] },
    "audits": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rubrics": { "type": "object", "additionalProperties": { "type": "string" } },
    "startedAt": { "type": "string" },
    "previous": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["commit", "dir"],
      "properties": {
        "commit": { "type": "string" },
        "dir": { "type": "string" }
      }
    },
    "accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audit", "key", "reason"],
        "properties": {
          "audit": { "type": "string" },
          "key": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guidanceFile": { "type": ["string", "null"] }
  }
}
