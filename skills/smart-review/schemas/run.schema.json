{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "smart-review run metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolVersion", "scoringVersion", "repo", "profile", "sections", "rubrics", "startedAt", "previous", "accepted", "guidanceFile"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "toolVersion": { "type": "string" },
    "scoringVersion": { "type": "string" },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "branch", "dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "profile": { "type": "string" },
    "lang": { "type": "string", "enum": ["en", "ru"] },
    "sections": { "type": "array", "items": { "type": "string" } },
    "reviewSections": { "type": "array", "items": { "type": "string" } },
    "topics": { "type": "array", "items": { "type": "string" } },
    "externalAssessments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web-pentest"],
      "properties": {
        "web-pentest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sourceAttempt", "recordedAtCommit"],
          "properties": {
            "status": { "enum": ["external-assessment-required", "metadata-supplied"] },
            "sourceAttempt": { "type": "string", "pattern": "^runs/[0-9a-f]{12}-[a-zA-Z0-9]+$" },
            "recordedAtCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "metadata": { "$ref": "#/$defs/assessmentMetadata" }
          },
          "if": { "properties": { "status": { "const": "metadata-supplied" } } },
          "then": { "required": ["metadata"] },
          "else": { "not": { "required": ["metadata"] } }
        }
      }
    },
    "carried": { "type": "object", "additionalProperties": { "type": "string" } },
    "stale": { "type": "object", "additionalProperties": { "type": "string" } },
    "baseDir": { "type": ["string", "null"] },
    "rubrics": { "type": "object", "additionalProperties": { "type": "string" } },
    "startedAt": { "type": "string" },
    "previous": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["commit", "dir"],
      "properties": {
        "commit": { "type": "string" },
        "dir": { "type": "string" }
      }
    },
    "accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "key", "reason"],
        "properties": {
          "section": { "type": "string" },
          "key": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guidanceFile": { "type": ["string", "null"] }
  },
  "if": { "required": ["topics"], "properties": { "topics": { "contains": { "const": "web-pentest" } } } },
  "then": {
    "required": ["reviewSections", "externalAssessments"],
    "properties": { "profile": { "const": "custom" } }
  },
  "else": { "properties": { "sections": { "minItems": 1 }, "reviewSections": { "minItems": 1 } } },
  "dependentRequired": { "externalAssessments": ["reviewSections", "topics"] },
  "$defs": {
    "metadataText": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069]{1,512}$"
    },
    "assessmentMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["assessmentDate", "scope"],
      "properties": {
        "assessmentDate": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "scope": { "$ref": "#/$defs/metadataText" },
        "deploymentId": { "$ref": "#/$defs/metadataText" },
        "reference": { "$ref": "#/$defs/metadataText" },
        "documents": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/metadataText" } }
      }
    }
  }
}
