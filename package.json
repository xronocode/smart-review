{
  "name": "@xronocode/smart-review",
  "version": "2.0.0",
  "description": "Section-based review of a repository and its changes for coding agents, with a CLI for deterministic scoring, machine verification, run comparison, and reports.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "smart-review": "skills/smart-review/cli/smart-review.mjs"
  },
  "files": [
    "skills/smart-review/cli",
    "skills/smart-review/schemas",
    "skills/smart-review/rubrics/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/cli/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xronocode/smart-review.git"
  }
}
